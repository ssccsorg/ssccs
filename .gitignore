# ============================================================
# Rust / Cargo
# ============================================================
target
debug

# Backup files from rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc
**/*.pdb

# Generated by cargo mutants
**/mutants.out*/

**/*_llms

# ============================================================
# Logs and temporary files
# ============================================================
**/*.log
**/*.bak
**/*.backup

# ============================================================
# Python
# ============================================================
**/__pycache__/
**/*.pyc
**/*.pyo
**/*.pyd
**/.ipynb_checkpoints/

# ============================================================
# Quarto (docs)
# ============================================================
**/.sdbtmp_*/
**/_sdbtmp_build/
**/*quarto_ipynb*
/docs/**/*_files
/docs/**/*_output
/docs/**/*_extensions 
/docs/**/*_libs
/docs/**/*.tex
/docs/**/*.pdf
/docs/**/*.html
/docs/**/*.c2pa_identifier.svg
/docs/**/*.aux
/docs/**/*.log
/docs/**/*.out
/docs/**/*.fls
/docs/**/*.fdb_latexmk
/docs/**/*.synctex.gz
/docs/**/*.bbl
/docs/**/*.bcf
/docs/**/*.run.xml

# Global Quarto
**/*.quarto_ipynb
**/*.quarto
**/*_site
**/*.toc
# ============================================================
# C2PA
# ============================================================
**/*.c2pa

# ============================================================
# Configuration directories
# ============================================================
**/.*
!/.vscode/
!/.github/
!**/.devcontainer/
!**/.dockerignore

# ============================================================
# docs/build.py
# ============================================================
# The folders sdbs writes for itself are ignored above: the .sdbtmp_ marker, and
# the plain _sdbtmp_build of the copy a parallel website build renders from.
_agent/
_pages/

# Generated by docs/poc/gen_xif_table.py at docs build time.
docs/poc/_include/
poc/baremetal_riscv/simulation/spike_test
poc/baremetal_riscv/simulation/asm_modules_test
poc/baremetal_riscv/simulation/concept*
!poc/baremetal_riscv/simulation/concept*.c
!poc/baremetal_riscv/simulation/concept*.S
!poc/baremetal_riscv/simulation/concept*.h
