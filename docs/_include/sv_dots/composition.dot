digraph SVModules {
    rankdir=TB; splines=ortho; nodesep=0.2; ranksep=0.3;
    node [shape=box, style="rounded,filled", fontsize=8, width=1.3];
    edge [fontsize=7];

    compose_intersect [label="compose_intersect\n← logic\n→ result", fillcolor="#d4f1f9"];
    compose_product_2d [label="compose_product_2d\n← c1_result\n← c2_result\n→ result", fillcolor="#d4f1f9"];
    compose_union [label="compose_union\n← logic\n→ result", fillcolor="#d4f1f9"];
}