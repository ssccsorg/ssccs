digraph SVModules {
    rankdir=TB; splines=ortho; nodesep=0.2; ranksep=0.3;
    node [shape=box, style="rounded,filled", fontsize=8, width=1.3];
    edge [fontsize=7];

    compose_intersect [label="compose_intersect\n← logic\n→ result", fillcolor="#d4f1f9"];
    compose_product_2d [label="compose_product_2d\n← c1_result\n← c2_result\n→ result", fillcolor="#d4f1f9"];
    compose_union [label="compose_union\n← logic\n→ result", fillcolor="#d4f1f9"];
    ck_eq [label="ck_eq\n← coord[64]\n→ result", fillcolor="#d4f1f9"];
    ck_even [label="ck_even\n← XOR\n← coord[64]\n→ result", fillcolor="#d4f1f9"];
    ck_gt [label="ck_gt\n← coord[64]\n→ result", fillcolor="#d4f1f9"];
    ck_range [label="ck_range\n← coord[64]\n→ result", fillcolor="#d4f1f9"];
    ck_range_010 [label="ck_range_010\n← coord[64]\n→ result", fillcolor="#d4f1f9"];
    observe [label="observe\n← constraint_result\n← projection[64]\n→ result[64]\n→ valid", fillcolor="#d4f1f9"];
    proj_identity [label="proj_identity\n← coord[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_negate [label="proj_negate\n← coord[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_parity [label="proj_parity\n← coord[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_sum2d [label="proj_sum2d\n← coord_a[64]\n← coord_b[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_sum3d [label="proj_sum3d\n← coord_a[64]\n← coord_b[64]\n← coord_c[64]\n→ result[64]", fillcolor="#d4f1f9"];
    ssccs_xif_coprocessor [label="ssccs_xif_coprocessor\n← clk\n← rst_n\n← xif_issue_valid\n→ xif_issue_ready\n← xif_issue_req_instr[32]\n← xif_issue_req_rs1[64]\n← xif_issue_req_rs2[64]\n← xif_issue_req_rs3[64]\n→ xif_result_valid\n← xif_result_ready\n→ xif_result_data[64]\n→ xif_result_rd[5]\n→ xif_result_exc", fillcolor="#d4f1f9"];
    ssccs_xif_coprocessor -> ck_even [label="u_ck_even"];
    ssccs_xif_coprocessor -> ck_range_010 [label="u_ck_range010"];
    ssccs_xif_coprocessor -> proj_identity [label="u_proj_id"];
