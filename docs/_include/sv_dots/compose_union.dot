digraph "compose_union" {
label="compose_union";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="constraint_results", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="result", color="black", fontcolor="black" ];
c6 [ shape=record, label="{{<p3> A|<p4> B}|$82\n$_OR_|{<p5> Y}}",  ];
x0 [ shape=record, style=rounded, label="<s0> 1:1 - 0:0 ", color="black", fontcolor="black" ];
x0:e -> c6:p3:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", label=""];
x1 [ shape=record, style=rounded, label="<s0> 0:0 - 0:0 ", color="black", fontcolor="black" ];
x1:e -> c6:p4:w [arrowhead=odiamond, arrowtail=odiamond, dir=both, color="black", fontcolor="black", label=""];
n1:e -> x0:s0:w [color="black", fontcolor="black", label=""];
n1:e -> x1:s0:w [color="black", fontcolor="black", label=""];
c6:p5:e -> n2:w [color="black", fontcolor="black", label=""];
}
