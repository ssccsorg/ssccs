digraph SVModules {
    rankdir=TB; splines=ortho; nodesep=0.2; ranksep=0.3;
    node [shape=box, style="rounded,filled", fontsize=8, width=1.3];
    edge [fontsize=7];

    proj_identity [label="proj_identity\n← coord[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_negate [label="proj_negate\n← coord[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_parity [label="proj_parity\n← coord[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_sum2d [label="proj_sum2d\n← coord_a[64]\n← coord_b[64]\n→ result[64]", fillcolor="#d4f1f9"];
    proj_sum3d [label="proj_sum3d\n← coord_a[64]\n← coord_b[64]\n← coord_c[64]\n→ result[64]", fillcolor="#d4f1f9"];
}