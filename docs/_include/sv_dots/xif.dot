    proj_negate [label="proj_negate", fillcolor="#f9f9d4", style="rounded,filled,dashed"];
    ck_range_010 [label="ck_range_010", fillcolor="#f9f9d4", style="rounded,filled,dashed"];
    proj_parity [label="proj_parity", fillcolor="#f9f9d4", style="rounded,filled,dashed"];
    ssccs_xif_coprocessor [label="ssccs_xif_coprocessor\n← clk\n← rst_n\n← xif_issue_valid\n→ xif_issue_ready\n← xif_issue_req_instr[32]\n← xif_issue_req_rs1[64]\n← xif_issue_req_rs2[64]\n← xif_issue_req_rs3[64]\n→ xif_result_valid\n← xif_result_ready\n→ xif_result_data[64]\n→ xif_result_rd[5]\n→ xif_result_exc", fillcolor="#d4f1f9"];
    ssccs_xif_coprocessor -> ck_even [label="u_ck_even"];
    ssccs_xif_coprocessor -> ck_range_010 [label="u_ck_range010"];
    ssccs_xif_coprocessor -> proj_identity [label="u_proj_id"];
