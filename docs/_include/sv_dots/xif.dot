    ssccs_xif_coprocessor -> proj_sum3d [label="u_proj_sum3d"];
    ssccs_xif_coprocessor -> proj_parity [label="u_proj_par"];
    ssccs_xif_coprocessor -> proj_negate [label="u_proj_neg"];
}