digraph "proj_parity" {
label="proj_parity";
rankdir="LR";
remincross=true;
n1 [ shape=octagon, label="coord", color="black", fontcolor="black" ];
n2 [ shape=octagon, label="result", color="black", fontcolor="black" ];
x0 [ shape=record, style=rounded, label="0 -&gt; 63:1 |<s0> 0:0 - 0:0 ", color="black", fontcolor="black" ];
n1:e -> x0:s0:w [color="black", fontcolor="black", label=""];
x0:e -> n2:w [color="black", fontcolor="black", style="setlinewidth(3)", label=""];
}
